# Local development only. Copy to .env (gitignored). Never commit real values.
# Production: the platform injects these as environment variables from a Kubernetes Secret.
# Keep simple KEY=VALUE lines: the Makefile and docker compose both read this file.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=0

POSTGRES_USER=risk
POSTGRES_PASSWORD=risk
POSTGRES_DB=risk

DATABASE_URL=postgres://risk:risk@localhost:5432/risk

RISK_TICKET_DEADLINE_SECONDS=10

PROVIDER_WS_URL=ws://localhost:8765
PROVIDER_WS_TOKEN=dev-token
